# Copy to .env and fill in. Never commit .env.

# Database (local only, bound to 127.0.0.1)
POSTGRES_DB=uzex
POSTGRES_USER=uzex_owner
POSTGRES_PASSWORD=change-me
AGENT_DB_USER=uzex_agent
AGENT_DB_PASSWORD=change-me-too
APP_DB_USER=uzex_app
APP_DB_PASSWORD=change-me-three
DB_PORT=55432

# LLM: any OpenAI-compatible API
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# App
APP_PORT=8080

# Public tunnel, only for: docker compose --profile public up -d
NGROK_AUTHTOKEN=

# Optional Telegram login. Leave empty to hide the button; the app works without it.
# Client ID comes from @BotFather > your bot > Login Widget, where you also add your public URL.
TELEGRAM_CLIENT_ID=
